<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="oval">
            <solid android:color="#33FF453A" />
        </shape>
    </item>

    <item
        android:bottom="2dp"
        android:left="2dp"
        android:right="2dp"
        android:top="2dp">
        <shape android:shape="oval">
            <gradient
                android:angle="45"
                android:endColor="#930000"
                android:startColor="#FFB5B0"
                android:centerColor="#FF463D" />
            <stroke
                android:width="1dp"
                android:color="#FFD0CC" />
        </shape>
    </item>

    <item
        android:bottom="8dp"
        android:left="6dp"
        android:right="6dp"
        android:top="4dp">
        <shape android:shape="oval">
            <solid android:color="#80FFFFFF" />
        </shape>
    </item>
</layer-list>
