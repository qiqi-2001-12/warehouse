<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="oval">
            <solid android:color="#332BFF63" />
        </shape>
    </item>

    <item
        android:bottom="2dp"
        android:left="2dp"
        android:right="2dp"
        android:top="2dp">
        <shape android:shape="oval">
            <gradient
                android:angle="45"
                android:endColor="#2E7A00"
                android:startColor="#D7FFB9"
                android:centerColor="#8BE300" />
            <stroke
                android:width="1dp"
                android:color="#E7FFD1" />
        </shape>
    </item>

    <item
        android:bottom="8dp"
        android:left="6dp"
        android:right="6dp"
        android:top="4dp">
        <shape android:shape="oval">
            <solid android:color="#80FFFFFF" />
        </shape>
    </item>
</layer-list>
